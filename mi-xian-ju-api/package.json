    "fetch:menus": "tsx scripts/fetch-menus-to-data.ts"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
